# ============================================================
# SWAP MONITOR — Exemplo de Configuração de Ambiente
# ============================================================
# Copie este arquivo para .env no ambiente de execução:
#   Linux VPS:  cp .env.example .env
#   Windows:    copy .env.example .env
#
# NUNCA commite o arquivo .env no Git.
# O sistema é SOMENTE de monitoramento de cotações.
# NÃO executa swaps, NÃO envia fundos, NÃO armazena chaves privadas.
# ============================================================

# ------------------------------------------------------------
# AMBIENTE & REDE
# ------------------------------------------------------------
# Ambiente de execução: production ou development
NODE_ENV=production

# Porta do servidor HTTP (VPS: 3100 recomendada para isolamento; dev: 3000)
PORT=3100

# Origem CORS permitida (em produção: domínio do dashboard ou vazio para mesma origem; dev: *)
CORS_ORIGIN=

# ------------------------------------------------------------
# MONITORAMENTO DE COTAÇÕES
# ------------------------------------------------------------
# Quantidade de DEPIX a simular na consulta de cotação
MONITOR_AMOUNT=1000

# Intervalo entre consultas automáticas (em segundos)
QUOTE_INTERVAL_SECONDS=300

# Par monitorado (padrão: DEPIX / Liquid → USDG / Arbitrum)
SOURCE_ASSET=DEPIX
SOURCE_NETWORK=liquid
DESTINATION_ASSET=USDG
DESTINATION_NETWORK=arbitrum

# ------------------------------------------------------------
# MODO MOCK (Simulação local sem chamadas a APIs externas)
# ------------------------------------------------------------
# false = consulta APIs reais
# true  = gera cotações simuladas realistas (para testes)
MOCK_MODE=false

# ------------------------------------------------------------
# BANCO DE DADOS (SQLite Local com WAL)
# ------------------------------------------------------------
# Caminho do arquivo SQLite (isolado em swap-monitor/data/)
DATABASE_PATH=./data/swap-monitor.db

# ------------------------------------------------------------
# PROVIDER: SIDESHIFT
# ------------------------------------------------------------
SIDESHIFT_ENABLED=true
SIDESHIFT_API_BASE_URL=https://sideshift.ai/api/v2

# API Key e Affiliate ID (opcionais para cotação variável de pares)
SIDESHIFT_API_KEY=
SIDESHIFT_AFFILIATE_ID=

# ------------------------------------------------------------
# PROVIDER: DEFLOW
# ------------------------------------------------------------
# Status: SUSPENSO / PENDENTE DE VALIDAÇÃO
# Manter desabilitado (false) até que os endpoints reais estejam validados
DEFLOW_ENABLED=false
DEFLOW_API_BASE_URL=
DEFLOW_API_KEY=
DEFLOW_API_SECRET=

# ------------------------------------------------------------
# ALERTAS: TELEGRAM (Opcional — desabilitado por padrão)
# ------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alerta quando score >= este valor (escala 0-100)
TELEGRAM_ALERT_SCORE_THRESHOLD=80

# Alerta quando diferença percentual entre provedores >= este valor (%)
TELEGRAM_ALERT_DIFF_THRESHOLD=0.30
