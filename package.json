{
  "name": "swap-monitor",
  "version": "1.0.0",
  "description": "Monitor de cotações DEPIX (Liquid) → USDG (Arbitrum) comparando SideShift e DeFlow",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:init": "tsx src/database/migrations.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "swap",
    "monitor",
    "depix",
    "usdg",
    "liquid",
    "arbitrum",
    "sideshift"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  }
}
